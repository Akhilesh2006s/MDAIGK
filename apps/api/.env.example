# MongoDB Atlas connection string (include the database name, e.g. /mango_dude)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mango_dude?retryWrites=true&w=majority
PORT=4000
NODE_ENV=development
# Generate long random strings for these (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated list of allowed web origins
CORS_ORIGINS=http://localhost:5173
DEFAULT_TIMEZONE=Asia/Kolkata
# Public base URL used in certificate verification references
PUBLIC_VERIFY_BASE_URL=http://localhost:4000/api/v1/public/certificates/verify
# Optional: resolvers for mongodb+srv lookups if Node's default DNS fails (Windows)
# DNS_SERVERS=8.8.8.8,1.1.1.1
